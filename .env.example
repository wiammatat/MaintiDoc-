# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais versionné.

# --- Modèles
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
IMAGE_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
IMAGE_ENCODER_MODEL=sentence-transformers/clip-ViT-B-32
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INDEX_VERSION=v1

# --- OCR (Tesseract)
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_PREFIX=models/tessdata
OCR_LANG=fra

# --- Qdrant
QDRANT_URL=http://localhost:6333

# --- PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=maintidoc
POSTGRES_USER=maintidoc
POSTGRES_PASSWORD=changeme

# --- Stockage de fichiers S3 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=maintidoc
S3_SECRET_KEY=changeme-s3
S3_BUCKET=maintidoc

# --- MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Sécurité
# Clé de signature des jetons d'approbation de tickets (générer une valeur aléatoire longue)
APPROVAL_SECRET=changeme-approval-secret
# Signature des jetons de connexion de l'API (valeur aléatoire longue)
JWT_SECRET=changeme-jwt-secret

# --- Budgets par demande
MAX_MCP_CALLS=3
MAX_MODEL_CALLS=6
MAX_PROCESSING_SECONDS=60

# --- API
# disabled : pas de VLM (POST /ask renvoie 503) ; qwen : GPU NVIDIA de ce PC ; remote : serveur VLM d'un autre PC
VLM_BACKEND=disabled
# Pour remote : adresse et jeton affichés par « python -m generation.vlm_server » sur le PC avec GPU
VLM_REMOTE_URL=
VLM_REMOTE_TOKEN=
VLM_REMOTE_TIMEOUT=180
MAX_UPLOAD_MB=5

# --- Application Gradio (python -m ui.app)
UI_API_URL=http://localhost:8000
UI_TIMEOUT=300

# --- Profil de stockage
# docker : MinIO + PostgreSQL (docker compose) ; local : disque seulement (Lightning AI Studio, sans Docker)
STORAGE_BACKEND=docker
# Qdrant embarqué (sans serveur) : chemin d'un dossier, ex. data/qdrant ; vide = serveur QDRANT_URL
# QDRANT_PATH=data/qdrant
